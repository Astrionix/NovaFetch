{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/stream.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "bin/**"
    },
    "api/download.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "bin/**"
    },
    "api/analyze.ts": {
      "memory": 512,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/analyze",
      "destination": "/api/analyze.ts"
    },
    {
      "source": "/api/stream",
      "destination": "/api/stream.ts"
    },
    {
      "source": "/api/download",
      "destination": "/api/download.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
